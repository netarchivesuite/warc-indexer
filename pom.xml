<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dk.kb.netarchivesuite.warcindexer</groupId>
    <artifactId>warc-indexer</artifactId>
    <packaging>jar</packaging>
    <name>warc-indexer</name>
    <url>https://github.com/netarchivesuite/warc-indexer</url>
    <version>3.5.2</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Must stay on Java 11 bytecode/API -->
        <maven.compiler.release>11</maven.compiler.release>
        <ram>1024</ram>

        <!-- Versions used in more than one place -->
        <tika.version>2.9.4</tika.version>
        <solr.version>9.10.1</solr.version>
        <!-- Must match the PDFBox version Tika uses (tika 2.9.4 -> pdfbox 2.0.34) -->
        <pdfbox.version>2.0.34</pdfbox.version>
        <!-- Jetty and ZooKeeper versions Solr 9.10 is built with -->
        <jetty.version>10.0.26</jetty.version>
        <zookeeper.version>3.9.4</zookeeper.version>
        <twelvemonkeys.version>3.13.1</twelvemonkeys.version>
        <!-- Solr 9.10 is built with Lucene 9.12.3, OpenSearch 2.19.2 with 9.12.1 (same 9.12 line).
             Solr 9.8.1 (Lucene 9.11.1) did not work with 9.12: Lucene99Codec moved out of lucene-core. -->
        <lucene.version>9.12.3</lucene.version>
        <opensearch.version>2.19.2</opensearch.version>
        <jackson.version>2.19.0</jackson.version>
        <slf4j.version>2.0.17</slf4j.version>
        <log4j.version>2.25.1</log4j.version>
    </properties>
    <organization>
        <name>The warc-indexer project contributor.</name>
        <url>https://github.com/netarchivesuite/warc-indexer/graphs/contributors</url>
    </organization>
    <inceptionYear>2013</inceptionYear>

    <licenses>
        <license>
            <name>GNU General Public License Version 2</name>
            <url>http://www.gnu.org/copyleft/gpl.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>


    <!-- Needed by maven-release-plugin (the old block pointed at an unrelated repo) -->
    <scm>
        <connection>scm:git:https://github.com/netarchivesuite/warc-indexer.git</connection>
        <developerConnection>scm:git:git@github.com:netarchivesuite/warc-indexer.git</developerConnection>
        <url>https://github.com/netarchivesuite/warc-indexer</url>
        <tag>HEAD</tag>
    </scm>


    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>src/main/solr</directory>
            </testResource>
        </testResources>
        <!-- Pin the default lifecycle plugins so builds are reproducible across Maven versions -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <!-- Runtime-scoped dependencies (Tika parsers, ImageIO plugins, logging backend) are
                             loaded via ServiceLoader and can never be seen by bytecode analysis. -->
                        <ignoreNonCompile>true</ignoreNonCompile>
                        <ignoredUnusedDeclaredDependencies>
                            <!-- Needed on the compile classpath, see comment on the dependency -->
                            <ignoredUnusedDeclaredDependency>org.slf4j:jcl-over-slf4j</ignoredUnusedDeclaredDependency>
                        </ignoredUnusedDeclaredDependencies>
                    </configuration>
                </plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.4.0</version></plugin>
            </plugins>
        </pluginManagement>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.6.3</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>11</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <scmCommentPrefix>[ci skip]</scmCommentPrefix>
                    <tagNameFormat>@{project.version}</tagNameFormat>
                </configuration>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <finalName>${project.build.finalName}-jar-with-dependencies</finalName>
                    <!-- Stop shade from writing dependency-reduced-pom.xml into the project root -->
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>**/Log4j2Plugins.dat</exclude>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>META-INF/*.EC</exclude>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                <exclude>log4j*</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <transformer
                                implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <manifestEntries>
                                <Main-Class>uk.bl.wa.indexer.WARCIndexerCommand</Main-Class>
                            </manifestEntries>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                            <resource>log4j2.xml</resource>
                            <file>src/main/resources/log4j2.xml</file>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <id>make</id>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-compiler-plugin</artifactId>
               <version>3.16.0</version>
               <!-- release=11 comes from the maven.compiler.release property -->
           </plugin>

            <plugin>
                <!-- Separates the unit tests from the integration tests. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- Skip the default running of this plug-in (or everything
                       is run twice...see below) -->
                    <skip>true</skip>
                    <!-- Show 100% of the lines from the stack trace (doesn't
                       work) -->
                    <trimStackTrace>false</trimStackTrace>
                    <argLine>-Xms${ram}m -Xmx${ram}m</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <!-- Never skip running the tests when the test phase
                               is invoked -->
                            <skip>false</skip>
                            <includes>
                                <!-- Include unit tests within integration-test phase. -->
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                            </includes>
                            <excludes>
                                <!-- Exclude integration tests within (unit) test
                                   phase. -->
                                <exclude>**/*IntegrationTest.java</exclude>
                                <exclude>**/*IntegrationTests.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <!-- Never skip running the tests when the integration-test
                               phase is invoked -->
                            <skip>false</skip>
                            <includes>
                                <!-- Include integration tests within integration-test
                                   phase. -->
                                <include>**/*IntegrationTest.java</include>
                                <include>**/*IntegrationTests.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <additionalOptions>-Xdoclint:none</additionalOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- SolrJ 9.x (Http2SolrClient / CloudHttp2SolrClient, used for the zookeeper mode)
                 is compiled against Jetty 10. The 3.5.2 jar contains Jetty 9.4.57 instead,
                 which lacks e.g. org.eclipse.jetty.io.ClientConnector.
                 Must be imported BEFORE tika-bom: with imported BOMs the first one wins,
                 and tika-bom 2.9.4 pins Jetty 9.4.57. -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-bom</artifactId>
                <version>${tika.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- The 3.5.2 jar mixes zookeeper 3.8.4 with zookeeper-jute 3.9.2 -->
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>${zookeeper.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper-jute</artifactId>
                <version>${zookeeper.version}</version>
            </dependency>

            <!-- The 3.5.2 jar mixes pdfbox/xmpbox 2.0.32 (from preflight) with fontbox/pdfbox-tools 2.0.34 (from Tika) -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>fontbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>xmpbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox-tools</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>

            <!-- The 3.5.2 jar has twelvemonkeys common-io 3.12.0 next to 3.13.1 of the rest -->
            <dependency>
                <groupId>com.twelvemonkeys.common</groupId>
                <artifactId>common-io</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.common</groupId>
                <artifactId>common-lang</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.common</groupId>
                <artifactId>common-image</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.imageio</groupId>
                <artifactId>imageio-core</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.imageio</groupId>
                <artifactId>imageio-metadata</artifactId>
                <version>${twelvemonkeys.version}</version>
            </dependency>

            <!-- org.opensearch:opensearch brings jakarta.annotation-api 1.3.5 (old javax.annotation package),
                 which beats the 2.1.1 (jakarta.annotation package) that Solr 9 / Jersey 3 need.
                 3.5.2 shipped 2.1.1; without this pin embedded Solr fails with
                 NoClassDefFoundError: jakarta/annotation/Priority. -->
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>2.1.1</version>
            </dependency>

            <!-- Lucene came out as a mix of 8.11.4 (lucene-core, pinned by tika-bom), 9.x via solr-core and 9.12.1 (via opensearch).
                 The shipped jar needs Lucene for the OpenSearch client, so align everything to its version. -->
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-core</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-common</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-backward-codecs</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-codecs</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-queries</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-queryparser</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-grouping</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-highlighter</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-join</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-misc</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-memory</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-sandbox</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-spatial3d</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-spatial-extras</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-suggest</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-classification</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-expressions</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-kuromoji</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-nori</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-phonetic</artifactId>
                <version>${lucene.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--Common modules start-->

        <!-- Used directly by LinkExtractor, WARCIndexer, FirstBytesAnalyser and
             AnnotationsFromAct (com.google.common.*). Previously arrived only
             transitively via tika-langdetect-optimaize's own dependency on
             com.optimaize.languagedetector:language-detector, which in turn
             depended on Guava. Note that webarchive-commons below explicitly
             *excludes* its own (older) bundled Guava, so something upstream
             always had to supply it. Now that tika-langdetect-optimaize is
             gone (replaced by tika-langdetect-opennlp), Guava must be
             declared directly instead of relying on that accidental path. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.19.0</version>
        </dependency>

        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.18.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>

        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.9.0</version>
        </dependency>

        <!-- Replaces javax.activation-api 1.2.0: jakarta.activation 1.2.2 (already pulled in via jaxb-runtime)
             contains the same javax.activation classes plus the implementation, so both ended up in the jar. -->
        <dependency>
            <groupId>com.sun.activation</groupId>
            <artifactId>jakarta.activation</artifactId>
            <version>1.2.2</version>
        </dependency>

        <!-- Used directly (ExternalServiceSolrFieldEnricher). Previously came in as 20131018 via webarchive-commons
             (CVE-2022-45688, CVE-2023-5072). -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>
        <!--Common modules end-->

        <!--p-hash and PDQ-hash for images-->
        <dependency>
          <groupId>io.github.netarchivesuite</groupId>
          <artifactId>image-hashes</artifactId>
          <version>1.1.1</version>
        </dependency>
        
        <dependency>
           <groupId>com.twelvemonkeys.imageio</groupId>
           <artifactId>imageio-webp</artifactId>
           <version>${twelvemonkeys.version}</version>
           <scope>runtime</scope>
       </dependency>

        <!-- ImageIO plugins are found at runtime via ServiceLoader, hence runtime scope. -->
        <!-- ICO/CUR reader (favicons): gives image_width/height. The JDK has no ICO reader. -->
        <dependency>
           <groupId>com.twelvemonkeys.imageio</groupId>
           <artifactId>imageio-bmp</artifactId>
           <version>${twelvemonkeys.version}</version>
           <scope>runtime</scope>
       </dependency>
        
        
      <!-- Source: https://mvnrepository.com/artifact/org.jwat/jwat-common -->
      <!-- This dependency use to come from Nanite/Droid dependency-->
      <dependency>
         <groupId>org.jwat</groupId>
         <artifactId>jwat-common</artifactId>
         <version>1.2.1</version>
         <scope>compile</scope>
         <exclusions>
            <!-- Old BouncyCastle 1.65 (known CVEs). The same org.bouncycastle classes come from
                 bcprov-jdk18on 1.80 via Tika, so 3080 classes overlapped in the shaded jar. -->
            <exclusion>
               <groupId>org.bouncycastle</groupId>
               <artifactId>bcprov-jdk15to18</artifactId>
            </exclusion>
         </exclusions>
      </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>

        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <!-- xml-apis (via tika-parser-xml-module -> xercesImpl) duplicates the JDK's java.xml module
                     (javax.xml.parsers/transform/stream/...). Eclipse refuses to compile with it on the
                     classpath ("package javax.xml.transform is accessible from more than one module"). -->
                <exclusion>
                    <groupId>xml-apis</groupId>
                    <artifactId>xml-apis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-html-commons</artifactId>
        </dependency>

        <!-- Language detection. Replaces carrotsearch:langid-java (archived/
             unmaintained upstream, Nov 2023). Supports ~115-120 languages
             versus optimaize's 71, with a model explicitly curated to drop
             languages that were easily confused with others. See
             LanguageAnalyser for the ISO 639-3 -> ISO 639-1 code mapping
             kept for backwards compatibility with content_language. -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-langdetect-opennlp</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Logging. Tika 2.9 and SolrJ 9 are built against SLF4J 2.x, so use the 2.x API and
             the matching log4j binding (log4j-slf4j2-impl instead of log4j-slf4j-impl). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
            <version>${slf4j.version}</version>
            <!-- Compile scope on purpose: it provides the org.apache.commons.logging API (commons-logging
                 itself is excluded everywhere), and httpclient / commons-httpclient classes we compile against
                 reference org.apache.commons.logging.Log. javac tolerates the missing type, but Eclipse's compiler
                 then produces broken class files (e.g. NoSuchMethodError on InputStreamUtils$HASH_STAGE.valueOf). -->
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--logging end-->

        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>1.4.3</version>
        </dependency>

        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>

        <dependency>
            <groupId>uk.bl.wa.sentimentalj</groupId>
            <artifactId>sentimentalj</artifactId>
            <version>1.0.2</version>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.brotli</groupId>
            <artifactId>dec</artifactId>
            <version>0.1.2</version>
